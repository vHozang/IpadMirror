+void
+netutils_padmirror_relay_register(unsigned short local_port, unsigned short remote_port)
+{
+    const char *configured_port = getenv("PADMIRROR_USB_RELAY_CONTROL_PORT");
+    struct sockaddr_in relay;
+    char message[64];
+    char *end = NULL;
+    long relay_port;
+    int fd;
+    int length;
+
+    if (!configured_port || configured_port[0] == '\0' ||
+        local_port == 0 || remote_port == 0) {
+        return;
+    }
+    relay_port = strtol(configured_port, &end, 10);
+    if (!end || *end != '\0' || relay_port <= 0 || relay_port > 65535) {
+        return;
+    }
+
+    fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (fd == -1) {
+        return;
+    }
+    memset(&relay, 0, sizeof(relay));
+    relay.sin_family = AF_INET;
+    relay.sin_port = htons((unsigned short) relay_port);
+    relay.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    length = snprintf(message, sizeof(message), "PMAP %u %u",
+                      local_port, remote_port);
+    if (length > 0 && length < (int) sizeof(message)) {
+        sendto(fd, message, length, 0,
+               (struct sockaddr *) &relay, sizeof(relay));
+    }
+    CLOSESOCKET(fd);
+}
